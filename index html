<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Rent-O-Friend</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial,sans-serif;
}

body{
  background:#f5f7fb;
  color:#222;
}

header{
  background:linear-gradient(135deg,#ff4b6e,#ff7a59);
  color:white;
  padding:18px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:10;
}

.logo{
  font-size:25px;
  font-weight:bold;
}

nav button{
  border:0;
  padding:10px 16px;
  margin-left:6px;
  border-radius:20px;
  background:white;
  color:#ff4b6e;
  font-weight:bold;
}

.hero{
  min-height:620px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:50px 20px;
  background:
    linear-gradient(rgba(0,0,0,.35),rgba(0,0,0,.45)),
    url("https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1600&q=80")
    center/cover;
}

.hero-box{
  max-width:750px;
  color:white;
}

.hero h1{
  font-size:52px;
  margin-bottom:18px;
}

.hero p{
  font-size:21px;
  line-height:1.5;
  margin-bottom:25px;
}

.fee{
  display:inline-block;
  background:white;
  color:#ff416c;
  padding:13px 25px;
  border-radius:30px;
  font-size:24px;
  font-weight:bold;
  margin-bottom:20px;
}

.main-btn{
  display:block;
  margin:10px auto;
  border:0;
  background:#ff416c;
  color:white;
  padding:15px 35px;
  border-radius:30px;
  font-size:18px;
  font-weight:bold;
  cursor:pointer;
}

.guarantee{
  margin-top:20px;
  background:rgba(255,255,255,.92);
  color:#222;
  padding:15px;
  border-radius:15px;
  font-weight:bold;
}

section{
  padding:55px 7%;
  text-align:center;
}

section h2{
  font-size:32px;
  margin-bottom:30px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:20px;
}

.card{
  background:white;
  padding:28px 20px;
  border-radius:18px;
  box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.card h3{
  margin:12px 0;
  color:#ff416c;
}

.card p{
  line-height:1.5;
}

footer{
  background:#20242c;
  color:white;
  padding:25px;
  text-align:center;
}

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  justify-content:center;
  align-items:center;
  z-index:100;
}

.modal-box{
  background:white;
  width:90%;
  max-width:420px;
  padding:30px;
  border-radius:20px;
}

.modal-box h2{
  margin-bottom:20px;
  text-align:center;
}

.modal-box input{
  width:100%;
  padding:13px;
  margin:8px 0;
  border:1px solid #ddd;
  border-radius:10px;
}

.close{
  float:right;
  font-size:25px;
  cursor:pointer;
}
</style>
</head>

<body>

<header>
  <div class="logo">❤️ Rent-O-Friend</div>

  <nav>
    <button onclick="openRegister()">Register</button>
    <button onclick="openLogin()">Login</button>
  </nav>
</header>

<div class="hero">

  <div class="hero-box">

    <div class="fee">Registration Fee ₹499</div>

    <h1>Find Someone. Meet Someone. ❤️</h1>

    <p>
      Need a friend for company, conversation, events or a meetup?
      Rent-O-Friend helps you connect with people nearby.
    </p>

    <button class="main-btn" onclick="openRegister()">
      Get Started
    </button>

    <div class="guarantee">
      🛡️ 10-Day Money Back Guarantee
      <br>
      If you don't get even one meetup request within 10 days,
      your registration fee is refundable.
    </div>

  </div>

</div>

<section>

  <h2>Why Rent-O-Friend?</h2>

  <div class="cards">

    <div class="card">
      <div style="font-size:40px;">🤝</div>
      <h3>Meet New People</h3>
      <p>
        Connect with people looking for friendship and company.
      </p>
    </div>

    <div class="card">
      <div style="font-size:40px;">💬</div>
      <h3>Send Requests</h3>
      <p>
        Send a meetup request and connect after the other person accepts.
      </p>
    </div>

    <div class="card">
      <div style="font-size:40px;">📍</div>
      <h3>Plan Meetups</h3>
      <p>
        Find suitable people and plan your meetup easily.
      </p>
    </div>

    <div class="card">
      <div style="font-size:40px;">🔒</div>
      <h3>Simple & Secure</h3>
      <p>
        Your connection starts only after a request is accepted.
      </p>
    </div>

  </div>

</section>

<footer>
  © 2026 Rent-O-Friend • Connect • Meet • Enjoy
</footer>
<!-- REGISTER MODAL -->

<div class="modal" id="registerModal">

  <div class="modal-box">

    <span class="close" onclick="closeModal()">×</span>

    <h2>Create Account</h2>

    <input
      type="text"
      id="name"
      placeholder="Your Name"
    >

    <input
      type="tel"
      id="phone"
      placeholder="Mobile Number"
    >

    <input
      type="email"
      id="email"
      placeholder="Email Address"
    >

    <input
      type="password"
      id="password"
      placeholder="Create Password"
    >

    <button
      class="main-btn"
      onclick="continuePayment()"
    >
      Continue • ₹499
    </button>

    <p style="text-align:center;margin-top:10px;">
      Already registered?
      <span
        onclick="switchToLogin()"
        style="color:#ff416c;font-weight:bold;cursor:pointer;"
      >
        Login
      </span>
    </p>

  </div>

</div>


<!-- LOGIN MODAL -->

<div class="modal" id="loginModal">

  <div class="modal-box">

    <span class="close" onclick="closeModal()">×</span>

    <h2>Welcome Back 👋</h2>

    <input
      type="tel"
      id="loginPhone"
      placeholder="Mobile Number"
    >

    <input
      type="password"
      id="loginPassword"
      placeholder="Password"
    >

    <button
      class="main-btn"
      onclick="loginUser()"
    >
      Login
    </button>

    <p style="text-align:center;margin-top:10px;">
      New user?
      <span
        onclick="switchToRegister()"
        style="color:#ff416c;font-weight:bold;cursor:pointer;"
      >
        Register
      </span>
    </p>

  </div>

</div>


<!-- PAYMENT NOTICE -->

<div class="modal" id="paymentModal">

  <div class="modal-box">

    <span class="close" onclick="closePayment()">×</span>

    <h2>Registration Fee ₹499</h2>

    <p style="text-align:center;line-height:1.6;margin-bottom:20px;">
      Your registration fee is ₹499.
      <br><br>
      After successful payment, your registration can be completed.
    </p>

    <button
      class="main-btn"
      onclick="makePayment()"
    >
      Pay ₹499
    </button>

  </div>

</div>


<script>

function openRegister(){

  document.getElementById("registerModal").style.display="flex";

}


function openLogin(){

  document.getElementById("loginModal").style.display="flex";

}


function closeModal(){

  document.getElementById("registerModal").style.display="none";

  document.getElementById("loginModal").style.display="none";

}


function switchToLogin(){

  closeModal();

  openLogin();

}


function switchToRegister(){

  closeModal();

  openRegister();

}


function continuePayment(){

  const name =
    document.getElementById("name").value.trim();

  const phone =
    document.getElementById("phone").value.trim();

  const email =
    document.getElementById("email").value.trim();

  const password =
    document.getElementById("password").value.trim();


  if(!name || !phone || !email || !password){

    alert("Please fill all details.");

    return;

  }


  document.getElementById("registerModal").style.display="none";

  document.getElementById("paymentModal").style.display="flex";

}


function closePayment(){

  document.getElementById("paymentModal").style.display="none";

}


function makePayment(){

  window.location.href =
  "https://rzp.io/rzp/u7he3XBj";

}


function loginUser(){

  const phone =
    document.getElementById("loginPhone").value.trim();

  const password =
    document.getElementById("loginPassword").value.trim();


  if(!phone || !password){

    alert("Please enter mobile number and password.");

    return;

  }


  alert("Login system will be connected with the backend soon.");

}

</script>
